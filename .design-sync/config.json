{
  "projectId": "393d33a5-6d08-43ce-972b-541f92e72077",
  "shape": "package",
  "pkg": "marketmind",
  "globalName": "FundersAIUI",
  "srcDir": "components/ui",
  "tsconfig": "tsconfig.json",
  "cssEntry": ".ds-compiled/tailwind.css",
  "readmeHeader": ".design-sync/conventions.md",
  "excludeSrcFiles": [
    "components/ui/info-card.tsx",
    "components/ui/animated-feature-carousel.tsx"
  ],
  "libOverrides": {
    "common.mjs": "adds 'excludeSrcFiles' to CONFIG_KEYS for the source-kit.mjs fork",
    "source-kit.mjs": "excludes next/image-importing files from entry synthesis + discovery (process.env.* referenced at module load time crashes the standalone esbuild bundle outside a real Next.js runtime); also adds named default-export re-exports to the synthesized entry, since bare 'export *' never re-exports a file's default export"
  },
  "overrides": {
    "Sheet": { "cardMode": "single", "viewport": "420x320" },
    "SheetContent": { "cardMode": "single", "viewport": "420x320" },
    "BentoGrid": { "cardMode": "column" },
    "SheetClose": { "cardMode": "single", "primaryStory": "CloseInSheet" },
    "SheetDescription": { "cardMode": "single", "primaryStory": "DescriptionInSheet" },
    "SheetFooter": { "cardMode": "single", "primaryStory": "FooterInSheet" },
    "SheetHeader": { "cardMode": "single", "primaryStory": "HeaderInSheet" },
    "SheetTitle": { "cardMode": "single", "primaryStory": "TitleInSheet" },
    "SheetTrigger": { "cardMode": "single", "primaryStory": "OpenFromTrigger" },
    "Sidebar": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarContent": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarFooter": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarGroup": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarGroupAction": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarGroupContent": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarGroupLabel": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarHeader": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarInput": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarInset": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarMenu": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarMenuAction": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarMenuBadge": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarMenuButton": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarMenuItem": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarMenuSkeleton": { "cardMode": "single", "primaryStory": "WithIcon" },
    "SidebarMenuSub": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarMenuSubButton": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarMenuSubItem": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarProvider": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarRail": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarSeparator": { "cardMode": "single", "primaryStory": "Default" },
    "SidebarTrigger": { "cardMode": "single", "primaryStory": "Default" },
    "Tooltip": { "cardMode": "single", "primaryStory": "RiskGradeTooltip" },
    "TooltipContent": { "cardMode": "single", "primaryStory": "ContentOverMetric" },
    "TooltipProvider": { "cardMode": "single", "primaryStory": "ProviderWithTooltip" },
    "TooltipTrigger": { "cardMode": "single", "primaryStory": "TriggerOnMetric" }
  }
